# PosePlanner — skill 打包設定範本
# 複製成 .env 後填入你自己的值；.env 不會進版控。
# build_skill_zip.sh 會讀 .env，把後端設定烤進 skill 的 data/config.json，
# 解壓到 ~/.claude/skills/poseplanner/ 後就不必再手動 set。
#
# 後端：local（本機資料夾圖庫）或 selfhost（私有 DB）
POSEPLANNER_BACKEND=selfhost

# ── selfhost 用 ──
POSEPLANNER_BASE_URL=http://192.168.x.x:8000
# 入庫用「讀寫」token（server 的 POSEPLANNER_TOKEN）；只搜尋的人可改填唯讀 token。
POSEPLANNER_TOKEN=

# ── local 用（留空 = ~/PosePlanner）──
POSEPLANNER_LIBRARY=
