flowchart TB
    subgraph ingest["📥 入庫端（Claude Code · 本機執行）"]
        src["cos 圖 / 本機資料夾<br/>或 IG · X · FB 貼文網址"]
        skill["poseplanner skill<br/>Claude 看圖 → 動作敘述 + 結構化標籤"]
        tax[("taxonomy.yaml<br/>標籤約束")]
        src --> skill
        tax -. 約束 .-> skill
    end

    cfg{{"data/config.json<br/>backend = local / selfhost<br/>（預設 local）"}}
    skill --> cfg

    subgraph localMode["🅐 local 模式（本機資料夾圖庫，零安裝）"]
        scripts["add_pose.py 入庫 / 刪圖<br/>search.py 搜尋"]
        lib[("~/PosePlanner/<br/>library.db + images/ + images/thumbs/")]
        scripts <--> lib
    end

    subgraph selfhost["🅑 selfhost 模式（自架私有 DB，內網）"]
        direction TB
        api["FastAPI server (api/app.py)<br/>/images /search<br/>/stats /thumbs /images 取原圖<br/>讀寫 + 唯讀 雙 token"]
        pg[("PostgreSQL + pgvector<br/>pgdata volume")]
        media[("media volume<br/>原圖 + 縮圖")]
        api <--> pg
        api <--> media
    end

    cfg -- local --> scripts
    cfg -- selfhost --> api

    subgraph webapp["🌐 找圖前端（Nuxt 3 · SSR）"]
        browser["瀏覽器 index.vue<br/>useFeed"]
        proxy["Nuxt server proxy<br/>/api/search /api/stats /api/media<br/>token 只在 server 端補上"]
        browser --> proxy
    end

    proxy -->|"帶讀取 token"| api

    vendor[("vendor/sqlite-vec<br/>vec0 向量引擎")]
    vendor -. loadable ext .-> scripts
