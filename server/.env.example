# 複製成 server/.env 後改掉這些值。.env 已被 .gitignore 排除，不會進版控。

# Postgres 帳密 / DB 名
POSTGRES_USER=poseplanner
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=poseplanner

# 寫入端點（/images、/fragments）需要的 Bearer token。
# 留空 = 純內網信任模式，不檢查 token（只建議在完全隔離的家用內網這樣）。
# 設了之後，Claude 端要用同一個 token：backend.py set --token <這個值>
POSEPLANNER_TOKEN=change-me-too

# api 對外埠（預設 8000）
API_PORT=8000
