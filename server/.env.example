# 複製成 server/.env 後改掉這些值。.env 已被 .gitignore 排除，不會進版控。

# Postgres 帳密 / DB 名
POSTGRES_USER=poseplanner
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=poseplanner

# 兩種權限的 token：
#   POSEPLANNER_TOKEN       讀寫：入庫 + 查詢 + 縮圖 + 『原圖』(/images)
#   POSEPLANNER_READ_TOKEN  唯讀：查詢（/search、/stats）+ 縮圖（/thumbs），不能入庫、也拿不到原圖
# 公開找圖頁請用『唯讀』token：它只看得到 1280px 縮圖，搬不走高清原圖。
# 兩個都留空 = 純內網信任模式，完全不檢查（只建議在完全隔離的家用內網這樣）。
# 設了之後，Claude 端用對應權限的 token：backend.py set --token <讀寫或唯讀>
POSEPLANNER_TOKEN=change-me-too
POSEPLANNER_READ_TOKEN=change-me-readonly

# api 對外埠（預設 8000）。若這台機器已經有服務站了 8000，改成沒人用的埠（如 8080）。
# 容器內部固定跑 8000，這裡只是 host 對外發布的埠；改這個不影響其他服務。
API_PORT=8000

# 前端找圖頁（web/）跨源讀取的放行來源。前端多半跟 server 不同源，瀏覽器的
# fetch(/search) 需要 server 回 CORS 標頭。留空或設 * = 放行所有來源（讀取仍受 token
# 把關）；要收斂就填逗號分隔的來源清單，例如：
#   POSEPLANNER_CORS_ORIGINS=http://localhost:8080,https://pose.example.com
POSEPLANNER_CORS_ORIGINS=*

# /search、/stats 的速率限制（每來源 IP）。防有人寫腳本快速列舉整庫。
# 預設 60/minute；想放寬就調大（如 120/minute），想實質關閉就設超大值（如 100000/minute）。
# 注意：反向代理後面要拿到真實 IP，本服務優先讀 X-Forwarded-For 第一段。
POSEPLANNER_SEARCH_RATE=60/minute
